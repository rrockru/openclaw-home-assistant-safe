{
  "name": "home-assistant-safe",
  "version": "0.2.0",
  "description": "Least-privilege Home Assistant tools for OpenClaw with entity-level ACLs and area-aware discovery.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "scripts",
    "openclaw.plugin.json",
    "README.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "plugin:metadata": "node ./scripts/openclaw-plugin.mjs metadata",
    "plugin:metadata:check": "node ./scripts/openclaw-plugin.mjs metadata:check",
    "plugin:build": "npm run build && npm run plugin:metadata",
    "plugin:validate": "node ./scripts/openclaw-plugin.mjs validate",
    "test": "vitest run",
    "check": "npm run build && npm run plugin:metadata:check && npm run plugin:validate && npm test",
    "prepack": "npm run check"
  },
  "dependencies": {
    "typebox": "1.1.38"
  },
  "peerDependencies": {
    "openclaw": ">=2026.5.17"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "openclaw": "2026.7.1-2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ]
  }
}
